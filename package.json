{
  "name": "wiffle-overlay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node scripts/seedPlayers.js",
    "snapshot": "node scripts/exportSnapshot.js",
    "backup": "node scripts/backupGames.js",
    "reset": "node scripts/resetDb.js",
    "deploy": "npm run build && firebase deploy --only hosting",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only database --project demo-wiffle \"vitest run --no-file-parallelism src/voting/__tests__/rules.test.ts src/postseason/__tests__/rules.test.ts\"",
    "schedule:sync": "node scripts/syncSchedule.mjs",
    "sponsors:seed": "node scripts/seedSponsors.mjs"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.8.0",
    "firebase-tools": "^15.11.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
